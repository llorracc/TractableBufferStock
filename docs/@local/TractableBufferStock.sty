% tex4ht gives a \label inside a footnote the footnote's number, so state the equation's number.
% Use this after the end of the equation, not inside it.
\providecommand{\labelEqInFootnote}[1]{%
  \protected@edef\@currentlabel{\theequation}%
  \ifcsname Configure\endcsname % only under tex4ht
    \Configure{newlabel}{\csname cur:th\endcsname\the\c@footnote}{\theequation}%
  \fi
  \label{#1}}

% A figure's note (Chris, 2026-11-27 14:36:37 EST): a paragraph beginning "Note:" under the figure, in smaller type,
% as close under the figure as it can be set. Each figure's PDF keeps a white margin of at least 7.6pt (as printed)
% below its lowest mark, so the note is raised 6pt into it. The web page does the same in proportion to the page's
% width: TractableBufferStock.cfg styles p.fignote.
\ifdefined\HCode
  \newcommand{\FigNote}[1]{\ifvmode\IgnorePar\fi\EndP\HCode{<p class="fignote">}\IgnorePar Note: #1\HCode{</p>}}
\else
  \newcommand{\FigNote}[1]{\par\nointerlineskip\vspace{-6pt}{\small\noindent Note: #1\par}}
\fi

% A note that is a margin note in the book's chapter prints as a footnote here (the book's rule
% margin-notes-not-footnotes); the sync check pairs it with the chapter's {margin} block.
\providecommand{\marginFootnote}[1]{\footnote{#1}}

% A figure's note ends with "[live version]", linked to the footnote that gives the figure notebook's links (Chris,
% 2026-11-27 22:11:09 EST): \LiveVersion{name}, where that footnote ends with \footnoteLabel{name}. The tie keeps the
% two words on one line.
% - In the PDF the name is a \label, recording the footnote's number rather than footmisc's \p@footnote, which the
%   other documents can't read when they load this one's labels.
% - On the web tex4ht puts each footnote on a page of its own, where a \label's link doesn't arrive. So the footnote
%   carries the name as an id, and TractableBufferStock.mk4 points each link at the page that holds it.
\ifdefined\HCode
  \newcommand{\footnoteLabel}[1]{\HCode{<a id='#1'></a>}}
  \newcommand{\LiveVersion}[1]{\HCode{<a href='\##1'>}[live~version]\HCode{</a>}}
\else
  \newcommand{\footnoteLabel}[1]{\protected@edef\@currentlabel{\arabic{footnote}}\label{#1}}
  \newcommand{\LiveVersion}[1]{\hyperref[#1]{[live~version]}}
\fi
